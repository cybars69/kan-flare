{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kan-flare",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Serve production on a Custom Domain (custom_domain: true), not a zone
  // route: wrangler deploy creates the DNS record and certificate. Must match
  // NEXT_PUBLIC_BASE_URL in .env; example.com must be in this account.
  "routes": [{ "pattern": "tasks.example.com", "custom_domain": true }],
  // Non-secret runtime settings. Secrets (BETTER_AUTH_SECRET, OAuth client
  // secrets…) come from .env and are uploaded by `pnpm --filter @kan/web deploy`.
  "vars": {
    "EMAIL_FROM": "Kan Flare <no-reply@tasks.example.com>",
    "DISABLE_NOTIFICATION_EMAILS": "true",
    "LOG_LEVEL": "info"
  },
  "observability": {
    "logs": { "enabled": true }
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kan-flare"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kan-flare",
      // No database_id: `wrangler deploy` provisions the database on first
      // deploy and reuses it afterwards. Local dev uses .wrangler/state.
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Buckets are created on first deploy when they don't exist yet.
  "r2_buckets": [
    { "binding": "AVATARS", "bucket_name": "kan-flare-avatars" },
    { "binding": "ATTACHMENTS", "bucket_name": "kan-flare-attachments" },
    // Resized/converted images made by /api/image.
    {
      "binding": "IMAGE_VARIANTS",
      "bucket_name": "kan-flare-image-variants"
    }
  ],
  // Cloudflare Images, used by /api/image to resize and convert. Billed per
  // unique transformation; variants are stored in R2 so each is made once.
  "images": { "binding": "IMAGES" },
  // Transactional email through Cloudflare Email Service. The EMAIL_FROM
  // domain must be onboarded (`wrangler email sending enable <domain>`).
  "send_email": [{ "name": "EMAIL" }],
  // Rate limits used by withRateLimit (packages/api/src/utils/rateLimit.ts):
  // RATE_LIMIT_<requests> per 60 seconds. namespace_id only has to be unique
  // within the account; staging uses its own so counters don't mix.
  "ratelimits": [
    {
      "name": "RATE_LIMIT_100",
      "namespace_id": "1100",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_300",
      "namespace_id": "1300",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_600",
      "namespace_id": "1600",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  // Bindings are not inherited by environments: add each one to env.staging.
  "env": {
    "staging": {
      "name": "kan-flare-staging",
      // Don't inherit production's custom domain; staging uses workers.dev
      // unless a domain of its own is added here.
      "routes": [],
      "vars": {
        "EMAIL_FROM": "Kan Flare <no-reply@tasks.example.com>",
        "DISABLE_NOTIFICATION_EMAILS": "true",
        "LOG_LEVEL": "info"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "kan-flare-staging"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kan-flare-staging",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "send_email": [{ "name": "EMAIL" }],
      "r2_buckets": [
        { "binding": "AVATARS", "bucket_name": "kan-flare-staging-avatars" },
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "kan-flare-staging-attachments"
        },
        {
          "binding": "IMAGE_VARIANTS",
          "bucket_name": "kan-flare-staging-image-variants"
        }
      ],
      "images": { "binding": "IMAGES" },
      "ratelimits": [
        {
          "name": "RATE_LIMIT_100",
          "namespace_id": "2100",
          "simple": { "limit": 100, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_300",
          "namespace_id": "2300",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_600",
          "namespace_id": "2600",
          "simple": { "limit": 600, "period": 60 }
        }
      ]
    }
  }
}
