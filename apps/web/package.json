{
  "name": "@kan/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @kan/mcp build && pnpm with-env next build --turbo",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "pnpm --filter @kan/mcp build && pnpm with-env next dev --turbo",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "start": "pnpm with-env next start",
    "test": "pnpm --filter @kan/mcp build && vitest run",
    "test:watch": "pnpm --filter @kan/mcp build && vitest",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && pnpm deploy:built",
    "deploy:built": "(CI=true wrangler d1 migrations apply kan-flare --remote || echo 'D1 database not provisioned yet; it is migrated after deploy.') && opennextjs-cloudflare deploy && CI=true wrangler d1 migrations apply kan-flare --remote",
    "deploy:staging": "opennextjs-cloudflare build && (CI=true wrangler d1 migrations apply kan-flare-staging --remote --env staging || echo 'D1 database not provisioned yet; it is migrated after deploy.') && opennextjs-cloudflare deploy --env staging && CI=true wrangler d1 migrations apply kan-flare-staging --remote --env staging",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && node -e \"const f='cloudflare-env.d.ts',fs=require('fs');fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/Service<typeof import\\(\\\"\\.\\/\\.open-next\\/worker\\\"\\)\\.default>/g,'Service').replace(/typeof import\\(\\\"\\.\\/\\.open-next\\/worker\\\"\\)/g,'unknown'))\"",
    "db:migrate": "wrangler d1 migrations apply kan-flare --local",
    "db:migrate:remote": "CI=true wrangler d1 migrations apply kan-flare --remote",
    "with-env": "dotenv -e ../../.env --",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile --typescript",
    "lingui:extract:watch": "lingui extract --watch"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.0",
    "@hookform/resolvers": "^3.3.4",
    "@kan/api": "workspace:*",
    "@kan/auth": "workspace:*",
    "@kan/db": "workspace:^",
    "@kan/email": "workspace:^",
    "@kan/logger": "workspace:^",
    "@kan/mcp": "workspace:*",
    "@kan/shared": "workspace:^",
    "@lingui/babel-preset-react": "^2.9.2",
    "@lingui/conf": "^5.3.2",
    "@lingui/macro": "^5.3.2",
    "@lingui/react": "^5.3.2",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@opennextjs/cloudflare": "1.20.9",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "catalog:",
    "@tiptap/extension-link": "^2.22.2",
    "@tiptap/extension-mention": "^3.0.9",
    "@tiptap/extension-placeholder": "^2.14.0",
    "@tiptap/extension-typography": "^3.18.0",
    "@tiptap/pm": "^2.14.0",
    "@tiptap/react": "^2.14.0",
    "@tiptap/starter-kit": "^2.14.0",
    "@tiptap/suggestion": "^2.14.0",
    "@trpc/client": "catalog:",
    "@trpc/next": "^11.0.0-rc.660",
    "@trpc/react-query": "catalog:",
    "@trpc/server": "catalog:",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.26.2",
    "geist": "^1.3.1",
    "jose": "^6.1.2",
    "next": "15.5.27",
    "next-runtime-env": "^1.7.2",
    "next-themes": "^0.4.6",
    "nextjs-cors": "^2.2.0",
    "posthog-js": "^1.254.0",
    "react": "catalog:react18",
    "react-contenteditable": "^3.3.7",
    "react-dom": "catalog:react18",
    "react-hook-form": "^7.51.1",
    "react-icons": "^5.5.0",
    "react-image-crop": "^11.0.10",
    "react-lottie-player": "^1.5.5",
    "react-markdown": "^10.1.0",
    "superjson": "2.2.1",
    "tailwind-merge": "^2.5.2",
    "tippy.js": "^6.3.7",
    "tiptap-markdown": "^0.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kan/eslint-config": "workspace:*",
    "@kan/prettier-config": "workspace:*",
    "@kan/stripe": "workspace:*",
    "@kan/tailwind-config": "workspace:*",
    "@kan/tsconfig": "workspace:*",
    "@lingui/cli": "^5.3.2",
    "@lingui/format-json": "^5.9.1",
    "@lingui/loader": "^5.3.2",
    "@lingui/swc-plugin": "^5.5.2",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20.17.7",
    "@types/react": "catalog:react18",
    "@types/react-dom": "catalog:react18",
    "dotenv-cli": "^7.4.4",
    "eslint": "catalog:",
    "jiti": "^1.21.6",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "^3.0.0",
    "wrangler": "4.148.0"
  },
  "prettier": "@kan/prettier-config"
}
